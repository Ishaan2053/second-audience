# Copy to .env and fill in. Never commit .env.
# Reference: docs/02-architecture.md section 3.1.

# dev, test or prod. In prod, FLAGSMITH_ENVIRONMENT_KEY, SA_DATABASE_URL and SA_LAB_KEY are required.
SA_ENV=dev

# Flagsmith server-side environment key (SDK).
FLAGSMITH_ENVIRONMENT_KEY=
# Optional override of the Flagsmith API URL.
FLAGSMITH_API_URL=
# Seconds per Flagsmith request before falling back to the control style (one retry).
FLAGSMITH_REQUEST_TIMEOUT_SECONDS=2
# Multivariate flag that assigns the error style.
SA_FLAG_NAME=error_style
# Flagsmith project (name or ID) the operator manages through the `flagsmith` CLI.
SA_FLAGSMITH_PROJECT=second-audience

# Ledger database. SQLite locally, Postgres when deployed
# (postgresql+psycopg://user:pass@host/dbname, psycopg 3 driver).
SA_DATABASE_URL=sqlite:///./sa.db

# Gemini API key for the lab runner and operator.
GEMINI_API_KEY=
# Comma-separated Gemini model IDs for lab traffic.
SA_LAB_MODELS=
# Shared secret that marks a session as lab traffic.
SA_LAB_KEY=
# MCP endpoint the lab runner targets.
SA_SERVER_URL=
# Lab pacing per model, kept below the Gemini free-tier limits. Requests per minute.
SA_LAB_REQUESTS_PER_MINUTE=8
# Requests per model per quota day (resets at midnight Pacific); the runner parks the model at it.
SA_LAB_REQUESTS_PER_DAY=400
# Lab sessions run at once, 1 to 3.
SA_LAB_CONCURRENCY=1
# Gemini model that drafts the prose of `sa report` (sections 1 and 9) and the proposals of
# `sa propose`. Needs GEMINI_API_KEY.
SA_OPERATOR_MODEL=gemini-3.5-flash-lite

# Per-session tool-call budget.
SA_MAX_TOOL_CALLS=12
# Idle seconds before a session is closed.
SA_SESSION_IDLE_SECONDS=600
# Rate limit for public (field) sessions: new sessions per client IP per hour.
SA_FIELD_SESSIONS_PER_IP_PER_HOUR=10
# Kill switch: false refuses new field sessions; lab sessions still work.
SA_FIELD_ENABLED=true
# Open sessions (lab and field) above which new field sessions are refused.
SA_MAX_CONCURRENT_SESSIONS=50
# Read the client IP from X-Forwarded-For. Only true behind the host's reverse proxy.
SA_TRUST_PROXY=false
# Commit shown at /healthz. Set by the host or the Docker build.
SA_GIT_COMMIT=
