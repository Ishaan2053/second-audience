# Copy to .env and fill in. Never commit .env.
# Reference: docs/02-architecture.md section 3.1.

# dev, test or prod. In prod, FLAGSMITH_ENVIRONMENT_KEY, SA_DATABASE_URL and SA_LAB_KEY are required.
SA_ENV=dev

# Flagsmith server-side environment key (SDK).
FLAGSMITH_ENVIRONMENT_KEY=
# Optional override of the Flagsmith API URL.
FLAGSMITH_API_URL=
# Seconds per Flagsmith request before falling back to the control style (one retry).
FLAGSMITH_REQUEST_TIMEOUT_SECONDS=2
# Multivariate flag that assigns the error style.
SA_FLAG_NAME=error_style

# Ledger database. SQLite locally, Postgres when deployed
# (postgresql+psycopg://user:pass@host/dbname, psycopg 3 driver).
SA_DATABASE_URL=sqlite:///./sa.db

# Gemini API key for the lab runner and operator.
GEMINI_API_KEY=
# Comma-separated Gemini model IDs for lab traffic.
SA_LAB_MODELS=
# Shared secret that marks a session as lab traffic.
SA_LAB_KEY=
# MCP endpoint the lab runner targets.
SA_SERVER_URL=

# Per-session tool-call budget.
SA_MAX_TOOL_CALLS=12
# Idle seconds before a session is closed.
SA_SESSION_IDLE_SECONDS=600
# Rate limit for public (field) sessions.
SA_FIELD_SESSIONS_PER_IP_PER_HOUR=10
